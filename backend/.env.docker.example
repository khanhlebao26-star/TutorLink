APP_NAME=TutorLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tutorlink
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOCAL_ADMIN_EMAIL=admin@tutorlink.local
LOCAL_ADMIN_PASSWORD=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

NOTIFICATION_PURGE_ACTOR_ID=

TELESCOPE_ENABLED=false
PULSE_ENABLED=false

MONITORING_REQUEST_SAMPLE_RATE=0.1
MONITORING_SLOW_QUERY_MS=500

MONITORING_ALERTS_ENABLED=false
MONITORING_ALERTS_SUPPRESSED=false
MONITORING_ALERT_COOLDOWN_SECONDS=600
MONITORING_SLOW_QUERY_ALERT_COUNT=5
MONITORING_SLOW_QUERY_WINDOW_SECONDS=300
# Enable locally after reviewing the Filament/Blade implementation.
ADMIN_PANEL_ENABLED=false

# Real Gmail SMTP (set in your local, ignored env file):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_REQUIRE_TLS=true
# MAIL_USERNAME=your-sender@gmail.com
# MAIL_PASSWORD="your-google-app-password"
# MAIL_FROM_ADDRESS=your-sender@gmail.com
MAIL_TIMEOUT=15
