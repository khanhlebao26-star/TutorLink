http://{$APP_DOMAIN} {
    redir {$APP_URL}{uri} 308
}

https://{$APP_DOMAIN} {
    {$TLS_CONFIG}

    root * /var/www/html/public
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    }

    @reverb path /app/* /apps/*
    handle @reverb {
        reverse_proxy reverb:8080
    }

    handle {
        php_fastcgi app:9000
        file_server
    }
}