# D06 smoke only. Replaces the development .env mount in compose.testing.yml.
# All credentials below are synthetic constants for the isolated test database.
APP_NAME=TutorLink
APP_ENV=testing
APP_DEBUG=false
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=http://127.0.0.1:18006
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=test-db
DB_PORT=5432
DB_DATABASE=tutorlink_test
DB_USERNAME=tutorlink_test_runner
DB_PASSWORD=tutorlink_test_password
DB_URL=

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_COOKIE=tutorlink-d06-smoke-session
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
