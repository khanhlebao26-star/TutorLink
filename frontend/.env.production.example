# Vercel: set Root Directory to frontend. Set these BEFORE building.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REVERB_APP_KEY=replace-with-public-reverb-key
NEXT_PUBLIC_REVERB_URL=wss://api.example.com
NEXT_PUBLIC_TUTOR_PROFILE_DOCUMENTS_REQUIRED=true
# Optional, use an authenticated HTTPS monitoring endpoint or a local SSH tunnel.
# NEXT_PUBLIC_HOST_DASHBOARD_URL=https://monitor.example.com
# Never put APP_KEY, REVERB_APP_SECRET or SMTP/database credentials here.
