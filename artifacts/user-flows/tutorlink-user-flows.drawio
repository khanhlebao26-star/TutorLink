  <diagram id="tutorlink-admin-flow" name="03 · Admin">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ADMIN — KIỂM DUYỆT &amp; ĐIỀU HÀNH HỆ THỐNG" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#10264B;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2300" height="47" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Hiện có hai giao diện: frontend :3000/admin và backend Filament :8000/admin · Quyền được kiểm tra theo từng thao tác." style="text;html=1;align=left;fontFamily=Arial;fontSize=15;fontColor=#667892;" vertex="1" parent="1">
          <mxGeometry x="50" y="86" width="2300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Trắng: trang hiện có    |    Tím: thao tác    |    Xanh lá: kết quả    |    Vàng: điều kiện    |    Xanh dương: giao vai trò / hệ thống    |    Cam: đề xuất gộp" style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#667892;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="2300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="band-0" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="2320" height="390" as="geometry" />
        </mxCell>
        <mxCell id="band-title-0" value="01  DUYỆT HỒ SƠ TUTOR — FRONTEND" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="189" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-0" value="Admin không đăng ký từ form học viên / tutor; tài khoản và permission cần được cấp trước. Quyết định phải kèm lý do." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="65" y="219" width="2260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band-1" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="2320" height="390" as="geometry" />
        </mxCell>
        <mxCell id="band-title-1" value="02  XỬ LÝ BÁO CÁO — BACKEND FILAMENT" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="614" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-1" value="Frontend hiện chưa có màn hình quản trị báo cáo tương ứng. Backend đã có tài nguyên Reports và trang Operations." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="65" y="644" width="2260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band-2" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="2320" height="390" as="geometry" />
        </mxCell>
        <mxCell id="band-title-2" value="03  ĐÁNH GIÁ, KIỂM DUYỆT &amp; VẬN HÀNH" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="1034" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-2" value="Các chức năng này đã có phía backend; không nhầm với menu /reports dành cho người gửi báo cáo." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="65" y="1064" width="2260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band-3" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="2320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="band-title-3" value="04  CÁC ĐIỂM VÀO KIỂM DUYỆT ĐANG TRÙNG NHAU" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="1454" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-3" value="Các nhánh bên dưới là hiện trạng đã xác minh trong code. Chọn một giao diện chính trước khi tiếp tục đầu tư thiết kế." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="65" y="1484" width="2260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band-4" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1650" width="2320" height="175" as="geometry" />
        </mxCell>
        <mxCell id="band-title-4" value="TIỆN ÍCH DÙNG CHUNG" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="1664" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-4" value="Lối vào từ header, avatar hoặc menu tài khoản; không vẽ lặp vào từng bước chính." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="65" y="1694" width="2260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band-5" value="" style="rounded=1;arcSize=5;fillColor=#F7F9FC;strokeColor=#E4EAF1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1870" width="2320" height="225" as="geometry" />
        </mxCell>
        <mxCell id="band-title-5" value="RÀ SOÁT ĐỂ GIẢM TRANG / GIẢM CÔNG THIẾT KẾ" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#208C78;" vertex="1" parent="1">
          <mxGeometry x="65" y="1884" width="2260" height="29" as="geometry" />
        </mxCell>
        <mxCell id="band-sub-5" value="Màu cam là đề xuất, chưa thay đổi chức năng trong dự án." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
