        <mxCell id="band-sub-0" value="Giấy tờ tùy cấu hình demo; production yêu cầu giấy tờ hợp lệ. Admin duyệt hồ sơ, không duyệt từng dịch vụ qua một trang riêng." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
