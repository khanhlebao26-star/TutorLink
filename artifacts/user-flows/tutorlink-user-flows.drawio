        <mxCell id="band-sub-1" value="Một mục menu “Quản lý giảng dạy”, gồm hai tab Dịch vụ / Chương trình học. Đây là hai nghiệp vụ khác nhau." style="text;html=1;align=left;fontFamily=Arial;fontSize=13;fontColor=#718096;" vertex="1" parent="1">
