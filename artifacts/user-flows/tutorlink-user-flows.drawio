        <mxCell id="band-title-2" value="03  TRAO ĐỔI → TẠO CHƯƠNG TRÌNH → GỬI LỜI MỜI" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#8156C7;" vertex="1" parent="1">
