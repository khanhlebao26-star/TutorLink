        <mxCell id="title" value="HỌC VIÊN — TỪ TÌM DỊCH VỤ ĐẾN HOÀN THÀNH" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#10264B;" vertex="1" parent="1">
