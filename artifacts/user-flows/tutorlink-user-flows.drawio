        <mxCell id="review" value="&lt;b&gt;Gửi đánh giá chương trình&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;Trong /programs/{id}&lt;br&gt;Điểm 1–5 và nhận xét&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F4EFFF;strokeColor=#A98BCF;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="1510" width="260" height="88" as="geometry" />
        </mxCell>
        <mxCell id="public-review" value="&lt;b&gt;Hiển thị review công khai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/tutors/{slug}?tab=reviews&lt;br&gt;Phụ thuộc trạng thái kiểm duyệt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#EAF3FF;strokeColor=#82ACE0;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="1510" width="260" height="88" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Nếu có vấn đề: gửi báo cáo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/reports?program_id={id}&lt;br&gt;Theo dõi trạng thái và kết quả&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#FFFFFF;strokeColor=#CAD4E2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1510" width="590" height="88" as="geometry" />
        </mxCell>
        <mxCell id="util-0" value="&lt;b&gt;Yêu thích&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/favorites&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F3F5F9;strokeColor=#B8C2D2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1735" width="425" height="88" as="geometry" />
        </mxCell>
        <mxCell id="util-1" value="&lt;b&gt;Thông báo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/notifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F3F5F9;strokeColor=#B8C2D2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="535" y="1735" width="425" height="88" as="geometry" />
        </mxCell>
        <mxCell id="util-2" value="&lt;b&gt;Tin nhắn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/messages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F3F5F9;strokeColor=#B8C2D2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="1735" width="425" height="88" as="geometry" />
        </mxCell>
        <mxCell id="util-3" value="&lt;b&gt;Cài đặt / đăng xuất&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/settings · avatar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F3F5F9;strokeColor=#B8C2D2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1445" y="1735" width="425" height="88" as="geometry" />
        </mxCell>
        <mxCell id="util-4" value="&lt;b&gt;Hỗ trợ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/support&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#F3F5F9;strokeColor=#B8C2D2;strokeWidth=1.4;spacing=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1735" width="425" height="88" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="&lt;b&gt;CÂN NHẮC GỘP: xem trước / chi tiết lời mời&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/invitations đã xem được thông tin và phản hồi. Có thể dùng một panel chi tiết; giữ deep link /invitations/{id}.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#FFF0DC;strokeColor=#D49A4C;strokeWidth=1.4;spacing=13;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1940" width="725" height="132" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;KHÔNG THIẾT KẾ LẠI: review route cũ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/tutors/{slug}/reviews hiện redirect về ?tab=reviews. Đây không còn là một màn hình độc lập.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#FFF0DC;strokeColor=#D49A4C;strokeWidth=1.4;spacing=13;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="835" y="1940" width="725" height="132" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;GIỮ: thông báo tài khoản ≠ thông báo lớp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#64748B&quot;&gt;/notifications là sự kiện toàn tài khoản. /programs/{id}/announcements là nội dung tutor đăng cho lớp. Học phí hiện không phải cổng thanh toán.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#152A4D;fillColor=#FFF0DC;strokeColor=#D49A4C;strokeWidth=1.4;spacing=13;arcSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1590" y="1940" width="725" height="132" as="geometry" />
        </mxCell>
