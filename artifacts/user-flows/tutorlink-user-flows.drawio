        <mxCell id="band-title-0" value="01  TÀI KHOẢN &amp; ĐIỀU KIỆN GIẢNG DẠY" style="text;html=1;align=left;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#8156C7;" vertex="1" parent="1">
