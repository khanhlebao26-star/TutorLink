        "laravel\/reverb": "v1.12.0",
        "pusher\/pusher-php-server": "7.3.0",
        "guzzlehttp\/guzzle": "7.16.1",
        "guzzlehttp\/psr7": "2.13.2",
        "symfony\/mime": "v7.4.22"
    }
}
