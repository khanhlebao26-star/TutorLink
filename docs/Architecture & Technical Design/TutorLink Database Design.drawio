        <mxCell id="notes-title" value="Ghi chú và ràng buộc" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=23;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="2928.0" width="1400" height="50" />
        </mxCell>
        <mxCell id="notes" value="Các bảng Laravel vận hành: cache/cache_locks, queue jobs, job_batches, failed_jobs và migrations. Không phải thực thể nghiệp vụ; chỉ được sử dụng nếu cấu hình driver tương ứng. Các mốc thời gian integer của queue/cache là Unix epoch; migrations.batch là đợt migration. Không đưa payload, exception hoặc token của các bảng này vào API công khai." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="2998.0" width="1400" height="144" />
        </mxCell>
