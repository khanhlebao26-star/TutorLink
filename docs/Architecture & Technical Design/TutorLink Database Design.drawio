          <mxGeometry as="geometry" x="25" y="2760.0" width="1400" height="50" />
        </mxCell>
        <mxCell id="notes" value="Fee Record có hai enum độc lập: status=declared/voided và tutor_payment_mark=unmarked/marked_paid/marked_unpaid. Kỳ tháng lưu period_start=ngày đầu tháng, period_end=ngày cuối cùng cùng tháng; API suy ra YYYY-MM. UNIQUE(program_id,period_start) áp dụng cả voided, không tái khai báo cùng kỳ. Số tiền VND nguyên ≥0; void giữ dấu thanh toán và là trạng thái cuối. Mỗi sửa phí/dấu thanh toán/void ghi Audit với lý do và thời gian. Review chỉ tạo cho Program completed hợp lệ, rating 1..5; visibility quyết định công khai. Report dùng open/resolved/dismissed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="2830.0" width="1400" height="172" />
        </mxCell>
