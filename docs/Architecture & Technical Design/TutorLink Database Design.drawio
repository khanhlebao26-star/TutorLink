          <mxGeometry x="0" y="614" width="600" height="48" as="geometry" />
        </mxCell>
        <mxCell id="task_submissions.request_hash" parent="task_submissions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;spacingLeft=10;spacingRight=5;fillColor=#FFF2CE;strokeColor=#DEE5ED;overflow=hidden;" value="&lt;b&gt;+ request_hash&lt;/b&gt; &lt;span style=&quot;color:#40536B&quot;&gt;: char(64)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#52657B&quot;&gt;NOT NULL · SHA-256 của payload chuẩn hóa&lt;/span&gt;" vertex="1">
          <mxGeometry x="0" y="662" width="600" height="48" as="geometry" />
        </mxCell>
      </root>
