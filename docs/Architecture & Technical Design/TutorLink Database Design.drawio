          <mxGeometry height="85" width="1460" x="1525" y="3720" as="geometry" />
        </mxCell>
        <mxCell id="guide-R62" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R62 · service_listings.id → listing_moderation_holds.listing_id&lt;br&gt;FK từ listing_moderation_holds.listing_id tới service_listings.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="3820" as="geometry" />
        </mxCell>
        <mxCell id="guide-R63" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R63 · users.id → listing_moderation_holds.hidden_by_admin_id&lt;br&gt;FK từ listing_moderation_holds.hidden_by_admin_id tới users.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="3920" as="geometry" />
        </mxCell>
        <mxCell id="guide-R64" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R64 · users.id → listing_moderation_holds.restored_by_admin_id&lt;br&gt;FK từ listing_moderation_holds.restored_by_admin_id tới users.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="4020" as="geometry" />
        </mxCell>
        <mxCell id="guide-R65" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R65 · users.id → favorites.user_id&lt;br&gt;FK từ favorites.user_id tới users.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="4120" as="geometry" />
        </mxCell>
        <mxCell id="guide-R66" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R66 · tutor_profiles.id → favorites.tutor_profile_id&lt;br&gt;FK từ favorites.tutor_profile_id tới tutor_profiles.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="4220" as="geometry" />
        </mxCell>
        <mxCell id="guide-R67" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;spacing=8;" value="R67 · users.id → idempotency_receipts.actor_id&lt;br&gt;FK từ idempotency_receipts.actor_id tới users.id; thiết kế đích đã chốt, chưa migration." vertex="1">
          <mxGeometry height="85" width="1460" x="1525" y="4320" as="geometry" />
