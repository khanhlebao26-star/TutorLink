          <mxGeometry as="geometry" y="470" width="600" height="48" />
        </mxCell>
        <mxCell id="idempotency_receipts._keys" value="PK id · UNIQUE(actor_id,idempotency_key) · BR-22/BR-23. Thiết kế đích; chưa migration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=8;fillColor=#F1F5F9;strokeColor=#DEE5ED;" parent="idempotency_receipts" vertex="1">
          <mxGeometry as="geometry" y="518" width="600" height="36" />
        </mxCell>
        <mxCell id="ref-idempotency_receipts.actor_id" parent="1" referenceColumns="users.id" relationshipCodes="R67" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;spacingLeft=10;fillColor=#EDF3FA;strokeColor=#1E3A5F;" value="&lt;b&gt;THAM CHIẾU KHÓA NGOẠI&lt;/b&gt;&lt;br&gt;users.id" vertex="1">
          <mxGeometry x="40" y="3016" width="440" height="38" as="geometry" />
        </mxCell>
        <mxCell id="route-idempotency_receipts.actor_id" edge="1" parent="1" source="ref-idempotency_receipts.actor_id" target="idempotency_receipts.actor_id" style="edgeStyle=none;noEdgeStyle=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endSize=9;strokeWidth=1.8;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#1E3A5F;" value="R67">
