          <mxGeometry as="geometry" x="25" y="1664.0" width="1400" height="50" />
        </mxCell>
        <mxCell id="notes" value="Mỗi lần nộp/cập nhật tạo một task_submissions mới. Idempotency-Key UUID và request_hash chống tạo version lặp khi retry: cùng key + cùng payload trả lại đúng version đã lưu; cùng key + payload khác trả 409. Kiểm quyền/scope trước khi replay. Key được giữ theo submission history; expected_submission_version kiểm tra khi tạo key/version mới. Đây là hợp đồng thiết kế, chưa phải migration/runtime." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
