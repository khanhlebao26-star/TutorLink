        <mxCell id="notes-title" value="Ghi chú và ràng buộc" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=23;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="3000.0" width="1400" height="50" />
        </mxCell>
        <mxCell id="notes" value="programs.customer_id là Customer đích cố định; owner_tutor_profile_id là Tutor duy nhất. Invitation giữ snapshot bất biến và expires_at = thời điểm gửi + 72 giờ. Thay index pending cũ bằng UNIQUE(program_id) WHERE status=pending; hết hạn phải chuyển expired trước khi gửi mới. Accept kiểm version/snapshot, tạo hai membership và chuyển Program active trong một transaction. Duy nhất một Customer member trong suốt Program; không tự thu hồi membership khi completed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="3070.0" width="1400" height="172" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
