        <mxCell id="notes-title" value="Ghi chú và ràng buộc" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=23;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="1704.0" width="1400" height="50" />
        </mxCell>
        <mxCell id="notes" value="sessions là phiên HTTP Laravel, khác program_sessions là buổi học. sessions.user_id chỉ được index trong migration hiện tại, không vẽ như FK thật. personal_access_tokens là bảng Sanctum hiện có; SPA cookie dùng sessions, không bắt buộc phát personal token. tokenable_type/tokenable_id là liên kết đa hình. password_reset_tokens.token lưu dạng hash, không lưu token thô; email liên kết logic với users.email." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="25" y="1774.0" width="1400" height="144" />
        </mxCell>
      </root>
