  <diagram id="rules" name="13 · Quy tắc toàn vẹn">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Quy tắc liên kết và toàn vẹn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="25" width="1800" height="60" />
        </mxCell>
        <mxCell id="rule-0" value="Tham chiếu đa hình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="100" width="1600" height="55" />
        </mxCell>
        <mxCell id="rule-1" value="file_links.resource_type + resource_id trỏ logic tới messages, tasks, task_submissions, announcements hoặc verification_documents. reports dùng tutor_profile/listing/message/program/review. audit_logs tham chiếu tài nguyên lịch sử. Những cặp này không thể đặt một FK SQL chung; service phải kiểm tra đúng type, row tồn tại và quyền truy cập, rồi xử lý gắn/xóa trong transaction. Không vẽ chúng thành FK thật." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="170" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-2" value="Các quan hệ và CHECK cần bổ sung" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="319" width="1600" height="55" />
        </mxCell>
        <mxCell id="rule-3" value="UNIQUE pending Invitation chỉ theo program_id. Giữ UNIQUE(program_id,user_id) và đổi unique Customer membership thành UNIQUE(program_id) WHERE member_role=customer, để một Program không có nhiều Customer lịch sử. Kiểm Customer đích/Customer member trùng programs.customer_id; Tutor member trùng chủ Program. Cột role/status phải có CHECK đúng enum, không còn observer, pending Program hoặc expired Conversation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="389" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-4" value="Giá và số lượng không âm; version ≥1; rating 1..5; weekday 0..6; end_time &amp;gt; start_time; planned_ends_at &amp;gt; planned_starts_at. Review comment tối đa 2.000 ký tự; Report details tối đa 2.000 ký tự, bắt buộc khi reason=other. Chỉ VND; expiry giấy tờ có thể NULL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="538" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-5" value="Chỉ FK program_id từ Invitation/Session tới programs.id; program_version và snapshot là dữ liệu lịch sử bất biến. Không dùng FK(program_id,program_version) tới row Program hiện tại vì version của Program có thể tăng. Kiểm version tại thời điểm gửi/accept bằng khóa transaction." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="687" width="1600" height="108" />
        </mxCell>
        <mxCell id="rule-6" value="Chỉ mục và xóa dữ liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="810" width="1600" height="55" />
        </mxCell>
        <mxCell id="rule-7" value="Giữ các index marketplace(status,specialization_id,delivery_mode,city,price_from_minor); inbox(invitee_user_id,status,expires_at); message(conversation_id,created_at,id); task(program_id,due_at,status); notification(user_id,read_at,created_at); report(status,created_at); audit(resource_type,resource_id,created_at). Đề xuất index mọi FK chưa được index bởi PK/UK; thêm submission(task_id,submission_version DESC), fee(program_id,period_start)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="880" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-8" value="Giữ lịch sử Program, Invitation, Submission, Fee, Review và Audit; không cascade hard delete vào các bảng này. Tài khoản ưu tiên status/soft delete. FK reviewer/actor có thể SET NULL khi chính sách xóa thật cho phép. File chỉ xóa object khi không còn liên kết và đã hết thời hạn lưu; một file_links row không trao quyền đọc cho mọi người dùng. Audit lưu lại reason/time cho thay đổi dấu thanh toán, đình chỉ, khôi phục và quyết định Admin." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1029" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-9" value="Phạm vi triển khai" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1178" width="1600" height="55" />
        </mxCell>
        <mxCell id="rule-10" value="Không tạo Order/Payment. Listing moderation hold là bảng riêng; chỉ Admin có quyền moderation mới hide/restore. Admin users/metrics giữ route Dự kiến đến khi controller/contract có thật. Không thêm hidden vào ListingStatus." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1248" width="1600" height="134" />
        </mxCell>
        <mxCell id="rule-11" value="Tài liệu nguồn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1397" width="1600" height="55" />
        </mxCell>
        <mxCell id="rule-12" value="Domain Model: https://docs.google.com/document/d/1sI98J0vYTh5EYdsII1s07_tWOh8Va3dmJn8g-po5vsw" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1467" width="1600" height="75" />
        </mxCell>
        <mxCell id="rule-13" value="Enum Catalog: https://docs.google.com/document/d/1LaqqMBoK4PKDsYv8tA-LOTMAdxxiL4xJruibKiHwOoY" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1557" width="1600" height="75" />
        </mxCell>
        <mxCell id="rule-14" value="Business Rules: https://docs.google.com/document/d/11A70iAzkKyAMpk0ZJg0MK_rN0_ZOXIx0Pw4XodHjvXs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1647" width="1600" height="75" />
        </mxCell>
        <mxCell id="rule-15" value="BR-22/23: receipt cùng transaction, khóa replay theo actor/key và hash; command chung giữ 30 ngày, Fee Record giữ theo vòng đời dữ liệu. BR-25: outbox tối đa 10 lần/60 phút; replay có reason/audit; row failed đã xử lý giữ 90 ngày, processed thường 30 ngày; notification 180 ngày, audit 24 tháng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#24364B;spacing=8;overflow=hidden;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1740" width="1600" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
